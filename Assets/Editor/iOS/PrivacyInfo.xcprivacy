<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Gizlilik bildirimi paket başınadır: burası yalnız UYGULAMANIN KENDİ kodunu anlatır.
         AdMob'un IDFA takibini ve alan adlarını GoogleMobileAds.xcframework ile
         UserMessagingPlatform.xcframework kendi manifestlerinde bildiriyor; burada tekrarlanmaz.

         NSPrivacyTracking'i true yapıp NSPrivacyTrackingDomains'i boş bırakmak ITMS-91064
         (Invalid tracking information) demek — yükleme "Invalid Binary"e düşer. Alan adlarını
         buraya yazmak da çözüm değil: ATT reddedilince iOS bu alan adlarına giden istekleri
         engelliyor, yani reklam doldurma tamamen ölüyor. Doğrusu, uygulamanın kendi kodu
         takip yapmadığı için burayı false bırakmak.

         App Store Connect gizlilik anketi bundan AYRIDIR: o anket uygulama geneli olduğu için
         AdMob'un topladıklarını da kapsamalı. Bu dosyayla birebir aynı olması beklenmez. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Satın alma geçmişi: Unity IAP / StoreKit. Kimlikle ilişkilendirilmiyor, izleme için değil. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- PlayerPrefs her yerde: ayarlar, değerlendirme sayacı, UMP'nin TCF dizesi.
             CA92.1 = yalnız uygulamanın kendi verisine erişim. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>

        <!-- SaveService, Application.persistentDataPath altına save.dat yazıp okuyor.
             C617.1 = dosyayı uygulamanın kendisi oluşturdu. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>

        <!-- Unity çalışma zamanı boş alanı sorgular. E174.1 = kullanıcıya gösterilmeyen iç kontrol. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>

        <!-- QualityService cihaz sınıfını ve çalışma süresini okuyor. 35F9.1 = ölçüm/telemetri değil, iç karar. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
